<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GNSS Interference Map</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<style>
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;font-family:Arial,Helvetica,sans-serif;overflow:hidden;background:#eef3f8;color:#0f172a}

.header{
    height:64px;background:#071a33;color:#fff;display:flex;align-items:center;
    justify-content:space-between;padding:0 24px;position:relative;z-index:2000
}
.brand{display:flex;align-items:center;gap:12px}
.brand-icon{width:38px;height:38px;border-radius:9px;background:#12345a;display:grid;place-items:center;font-size:19px}
.brand h1{margin:0;font-size:19px}
.brand p{margin:3px 0 0;color:#b9c7d8;font-size:11px}
.status{color:#8ef0c0;background:#0b3a2a;border-radius:999px;padding:7px 11px;font-size:11px}

.workspace{position:relative;width:100%;height:calc(100vh - 64px)}
#map{position:absolute;inset:0;background:#0b1726}

.controls{
    position:absolute;z-index:1000;top:16px;left:16px;
    background:rgba(255,255,255,.97);border:1px solid #d7e0ea;border-radius:10px;
    box-shadow:0 4px 18px rgba(15,23,42,.16);padding:13px;
    width:min(760px,calc(100vw - 32px))
}
.controls-title{font-size:12px;font-weight:700;color:#17304f;margin-bottom:10px}
.mode-row{display:flex;gap:6px;margin-bottom:9px}
.mode-btn{height:30px;padding:0 13px;border:1px solid #cbd5e1;border-radius:6px;background:#f8fafc;color:#475569;font-size:11px;font-weight:700;cursor:pointer}
.mode-btn.active{background:#0b5cab;border-color:#0b5cab;color:#fff}
.control-row{display:grid;grid-template-columns:1fr 1fr 150px 150px 125px;gap:8px}
.control input{width:100%;height:38px;border:1px solid #cbd5e1;border-radius:6px;padding:0 10px;font-size:13px;outline:none}
.control input:focus{border-color:#2563eb}
.check-btn{height:38px;border:0;border-radius:6px;background:#0b5cab;color:#fff;font-size:12px;font-weight:700;cursor:pointer}
.check-btn:hover{background:#084b8d}
.error{display:none;margin-top:8px;padding:8px 10px;border-radius:6px;background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;font-size:11px}

.map-info{
    position:absolute;z-index:1000;right:16px;top:16px;width:255px;
    background:rgba(255,255,255,.96);border:1px solid #d7e0ea;border-radius:10px;
    box-shadow:0 4px 18px rgba(15,23,42,.14);padding:14px
}
.info-title{font-size:12px;font-weight:700;color:#17304f;margin-bottom:9px}
.route-result{font-size:12px;color:#475569;line-height:1.5;margin-bottom:10px}
.route-result strong{color:#0f172a}
.legend{border-top:1px solid #e2e8f0;padding-top:9px}
.legend-item{display:flex;align-items:center;gap:8px;margin:7px 0;font-size:11px;color:#475569}
.swatch{width:17px;height:11px;border-radius:3px;border:1px solid rgba(0,0,0,.15)}
.line-swatch{width:22px;height:4px;border-radius:4px;background:#1261c9}
.live-note{margin-top:8px;padding-top:8px;border-top:1px solid #e2e8f0;font-size:10px;line-height:1.45;color:#64748b}

.email-panel{
    position:absolute;z-index:1000;left:16px;bottom:16px;width:min(520px,calc(100vw - 32px));
    background:rgba(255,255,255,.97);border:1px solid #d7e0ea;border-radius:10px;
    box-shadow:0 4px 18px rgba(15,23,42,.14);padding:13px
}
.email-title{font-size:12px;font-weight:700;color:#17304f;margin-bottom:8px}
.email-text{font-size:11px;line-height:1.5;color:#334155;white-space:pre-wrap;max-height:105px;overflow-y:auto}
.copy-btn{margin-top:8px;height:31px;padding:0 12px;border:1px solid #b8c5d4;background:#fff;border-radius:6px;cursor:pointer;color:#17304f;font-size:11px;font-weight:700}
.copy-btn:hover{background:#f8fafc}

.airport-marker{width:11px;height:11px;border-radius:50%;background:#fff;border:3px solid #0b5cab;box-shadow:0 1px 5px rgba(0,0,0,.35)}
.map-label{font-size:10px;font-weight:700;color:#1e293b;background:rgba(255,255,255,.94);border:1px solid #cbd5e1;padding:2px 5px}

.country-name{
    color:#cbd5e1;
    font-size:9px;
    font-weight:600;
    letter-spacing:.15px;
    white-space:nowrap;
    text-shadow:0 1px 3px rgba(0,0,0,.95),0 -1px 3px rgba(0,0,0,.95);
    pointer-events:none;
}

.airport-label{
    color:#e5edf7;
    background:rgba(15,27,42,.94);
    border:1px solid #52657a;
    border-radius:4px;
    padding:2px 5px;
    font-size:10px;
    font-weight:700;
    white-space:nowrap;
    box-shadow:0 1px 3px rgba(15,23,42,.2);
}
.city-label{background:transparent;border:0;white-space:nowrap;pointer-events:none}.city-label span{display:inline-block;margin-left:5px;margin-top:-7px;padding:1px 4px;border-radius:3px;background:rgba(255,255,255,.88);color:#334155;font-size:9px;font-weight:700;box-shadow:0 1px 2px rgba(0,0,0,.12)}

@media(max-width:900px){
    .control-row{grid-template-columns:1fr 1fr}
    .check-btn{width:100%}
    .map-info{top:auto;bottom:16px;right:16px}
    .email-panel{display:none}
}
@media(max-width:600px){
    .header{padding:0 13px}
    .brand p,.status{display:none}
    .controls{top:8px;left:8px;width:calc(100vw - 16px)}
    .map-info{display:none}
}
</style>
</head>

<body>
<header class="header">
    <div class="brand">
        <div class="brand-icon">✈</div>
        <div>
            <h1>GNSS Interference Map</h1>
            <p>Flight Route • Jamming • Spoofing Investigation</p>
        </div>
    </div>
    <div class="status">● GNSS DATA READY</div>
</header>

<div class="workspace">
    <div id="map"></div>

    <div class="controls">
        <div class="controls-title">Route Check</div>
        <div class="mode-row">
            <button id="historyModeBtn" class="mode-btn active" onclick="setMode('history')">HISTORY</button>
            <button id="liveModeBtn" class="mode-btn" onclick="setMode('live')">LIVE</button>
        </div>
        <div class="control-row">
            <div class="control"><input id="from" value="COK" placeholder="FROM: IATA / ICAO"></div>
            <div class="control"><input id="to" value="RUH" placeholder="TO: IATA / ICAO"></div>
            <div class="control" id="dateControl"><input id="date" type="date" value="2026-09-17"></div>
            <div class="control"><input id="speed" type="number" value="850" min="100" max="1200" placeholder="Speed km/h"></div>
            <button class="check-btn" onclick="checkRoute()">CHECK ROUTE</button>
        </div>
        <div id="error" class="error"></div>
    </div>

    <div class="map-info">
        <div class="info-title">Route Result</div>
        <div class="route-result" id="routeResult">Select a route and click <strong>CHECK ROUTE</strong>.</div>
        <div class="legend">
            <div class="legend-item"><span class="swatch" style="background:#f59e0b"></span>GNSS interference</div>
            <div class="legend-item"><span class="swatch" style="background:#dc2626"></span>High GNSS interference</div>
                        <div class="legend-item"><span class="line-swatch"></span>Route</div>
            <div class="live-note">Live mode shows current ADS-B navigation-quality degradation indicators. It does not prove a jammer is present.</div>
        </div>
    </div>

    <div class="email-panel">
        <div class="email-title">Email Statement</div>
        <div class="email-text" id="emailStatement">Run a route analysis to generate the statement.</div>
        <button class="copy-btn" onclick="copyEmail()">COPY STATEMENT</button>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@turf/turf@7/turf.min.js"></script>
<script src="https://unpkg.com/h3-js@4.1.0/dist/h3-js.umd.js"></script>

<script>
let airports=[],gpsjam=[],firs=[],easaCodes=[],countries=[];
let gpsjamByHex=new Map();
let map,worldLayer,worldLabelLayer,routeLayer,gpsjamLayer,markerLayer;
let currentEmail="";
let currentMode="history";
let liveLayer=null;
let liveTimer=null;
let liveLastUpdated=null;

const DATA={
    airports:"data/airports.json",
    firs:"data/firs.geojson",
    easa:"data/easa-spoofing.json",
    countries:"data/countries.geojson"
};

async function loadData(){
    try{
        const [a,f,e,c]=await Promise.all([
            fetch(DATA.airports),fetch(DATA.firs),
            fetch(DATA.easa),fetch(DATA.countries)
        ]);

        if(!a.ok)throw new Error("Could not load airports.json");
        if(!f.ok)throw new Error("Could not load FIR data");
        if(!e.ok)throw new Error("Could not load EASA data");
        if(!c.ok)throw new Error("Could not load countries.geojson");

        airports=await a.json();
        firs=await f.json();
        easaCodes=await e.json();
        countries=await c.json();

        initializeMap();

        const date=document.getElementById("date").value;
        await loadGpsjamForDate(date);
    }catch(err){
        console.error(err);
        showError("Data loading failed: "+err.message);
        document.querySelector(".status").textContent="● DATA ERROR";
    }
}

async function loadGpsjamForDate(date){
    const status=document.querySelector(".status");
    const file=`data/gpsjam/${date}.json`;

    status.textContent="● LOADING GPSJAM…";

    try{
        const response=await fetch(file,{cache:"no-store"});

        if(!response.ok){
            throw new Error(`GPSJAM dataset not found for ${date}`);
        }

        const text=await response.text();

        if(!text.trim()){
            throw new Error(`GPSJAM dataset for ${date} is empty`);
        }

        const data=JSON.parse(text);

        if(!Array.isArray(data)){
            throw new Error(`Invalid GPSJAM dataset for ${date}`);
        }

        gpsjam=data;
        gpsjamByHex.clear();

        gpsjam.forEach(x=>{
            if(x&&x.hex)gpsjamByHex.set(x.hex,x);
        });

        drawGpsjam();

        status.textContent="● GNSS DATA READY";

        updateGpsjamInfo(date);

        // Recalculate the currently selected route using the newly loaded date.
        const from=findAirport(document.getElementById("from").value);
        const to=findAirport(document.getElementById("to").value);
        const speed=Number(document.getElementById("speed").value);

        if(from && to && speed>0 && routeLayer){
            analyzeRoute(from,to,speed);
        }

        console.log(`GPSJAM loaded: ${date} (${gpsjam.length} cells)`);

    }catch(err){
        gpsjam=[];
        gpsjamByHex.clear();
        if(gpsjamLayer)gpsjamLayer.clearLayers();

        status.textContent="● GPSJAM DATA UNAVAILABLE";
        showError(err.message);

        const info=document.getElementById("routeResult");
        if(info)info.innerHTML="<strong>No GPSJAM data available</strong><br>"+escapeHtml(date);

        console.error(err);
    }
}

function updateGpsjamInfo(date){
    const info=document.getElementById("routeResult");
    if(!info)return;

    // Keep route results if a route has already been checked.
    if(info.dataset.routeChecked==="true")return;

    info.innerHTML=
        "<strong>GPSJAM dataset:</strong> "+
        escapeHtml(formatDate(date))+
        "<br>"+gpsjam.length.toLocaleString()+" cells loaded.";
}

function formatDate(date){
    const d=new Date(date+"T00:00:00Z");
    return d.toLocaleDateString("en-GB",{
        day:"2-digit",month:"short",year:"numeric",timeZone:"UTC"
    });
}

function initializeMap(){
    map=L.map("map",{
        minZoom:2,maxZoom:8,worldCopyJump:false,
        maxBounds:[[-85,-180],[85,180]],maxBoundsViscosity:1,
        zoomControl:true
    });

    map.createPane("worldPane");
    map.getPane("worldPane").style.zIndex=200;

    map.createPane("gpsPane");
    map.getPane("gpsPane").style.zIndex=400;

    map.createPane("routePane");
    map.getPane("routePane").style.zIndex=500;

    map.createPane("markerPane");
    map.getPane("markerPane").style.zIndex=600;

    map.createPane("labelPane");
    map.getPane("labelPane").style.zIndex=650;

    map.setView([20,50],3);

    /*
     * Local Natural Earth country boundaries.
     * EASA FIR polygons are intentionally NOT drawn globally.
     * They are only used to classify the selected route.
     * This prevents airspace boundaries from appearing as
     * large purple shapes over the map.
     */
    worldLayer=L.geoJSON(countries,{
        pane:"worldPane",
        style:()=>({
            color:"#52657a",
            weight:1,
            opacity:1,
            fillColor:"#172536",
            fillOpacity:1
        }),
        onEachFeature:(feature,layer)=>{
            const p=feature.properties||{};
            const name=p.NAME||p.ADMIN||p.NAME_LONG||p.name||"";
            if(name)layer.bindTooltip(name,{
                sticky:true,direction:"top",className:"map-label"
            });
        }
    }).addTo(map);

    // Create all overlay groups BEFORE drawing any data.
    // Permanent country names for a more presentable aviation-style map.
    // Labels are separate from the country polygons and disappear when zoomed out too far.
    worldLabelLayer=L.layerGroup().addTo(map);

    countries.features.forEach(feature=>{
        const p=feature.properties||{};
        const name=p.NAME||p.ADMIN||p.NAME_LONG||p.name||"";
        if(!name)return;

        try{
            const temp=L.geoJSON(feature);
            const center=temp.getBounds().getCenter();

            L.marker(center,{
                interactive:false,
                icon:L.divIcon({
                    className:"country-name",
                    html:escapeHtml(name),
                    iconSize:null,
                    iconAnchor:[0,0]
                })
            }).addTo(worldLabelLayer);
        }catch(err){}
    });

    gpsjamLayer=L.layerGroup().addTo(map);
    liveLayer=L.layerGroup().addTo(map);
    routeLayer=L.layerGroup().addTo(map);
    markerLayer=L.layerGroup().addTo(map);

    map.on("zoomend",updateCountryLabels);
    updateCountryLabels();

    // Airports are intentionally NOT drawn globally.
    // Only FROM and TO airports are displayed after route analysis.

    // GPSJAM is loaded asynchronously for the selected date.
    // Do not load a hard-coded historical dataset here.

    const dateInput=document.getElementById("date");
    dateInput.addEventListener("change",()=>{
        if(currentMode!=="history")return;
        clearError();
        loadGpsjamForDate(dateInput.value);
    });

    setTimeout(()=>{
        map.invalidateSize(true);
        console.log("World features:", worldLayer.getLayers().length);
        console.log("GPSJAM layers:", gpsjamLayer.getLayers().length);
    },200);
}


function setMode(mode){
    currentMode=mode;
    document.getElementById("historyModeBtn").classList.toggle("active",mode==="history");
    document.getElementById("liveModeBtn").classList.toggle("active",mode==="live");
    document.getElementById("dateControl").style.display=mode==="history"?"block":"none";
    clearError();

    if(liveTimer){clearInterval(liveTimer);liveTimer=null;}

    if(mode==="history"){
        liveLayer.clearLayers();
        loadGpsjamForDate(document.getElementById("date").value);
    }else{
        gpsjamLayer.clearLayers();
        startLiveMode();
    }
}

async function startLiveMode(){
    liveLayer.clearLayers();
    const from=findAirport(document.getElementById("from").value);
    const to=findAirport(document.getElementById("to").value);
    if(!from || !to){
        showError("Enter valid FROM and TO airports for live mode.");
        return;
    }
    await loadLiveForRoute(from,to);
    liveTimer=setInterval(()=>{
        if(currentMode==="live")loadLiveForRoute(from,to);
    },60000);
}

function liveSamplePoints(from,to){
    const route=turf.lineString([
        [airportLon(from),airportLat(from)],
        [airportLon(to),airportLat(to)]
    ]);
    const distanceKm=turf.length(route,{units:"kilometers"});
    const count=Math.min(6,Math.max(2,Math.ceil(distanceKm/700)));
    const points=[];
    for(let i=0;i<count;i++){
        const p=turf.along(route,distanceKm*i/(count-1),{units:"kilometers"});
        const [lon,lat]=p.geometry.coordinates;
        points.push({lat,lon});
    }
    return points;
}

async function fetchLivePoint(lat,lon){
    const url="https://api.adsb.lol/v2/lat/"+encodeURIComponent(lat)+"/lon/"+encodeURIComponent(lon)+"/dist/100";
    const r=await fetch(url,{cache:"no-store"});
    if(!r.ok)throw new Error("Live ADS-B request failed ("+r.status+")");
    const d=await r.json();
    return Array.isArray(d.ac)?d.ac:[];
}

async function loadLiveForRoute(from,to){
    document.querySelector(".status").textContent="● LOADING LIVE DATA…";
    liveLayer.clearLayers();
    try{
        const unique=new Map();
        for(const p of liveSamplePoints(from,to)){
            const ac=await fetchLivePoint(p.lat,p.lon);
            ac.forEach(a=>{
                if(!a.hex || a.lat==null || a.lon==null || a.nac_p==null)return;
                const old=unique.get(a.hex);
                if(!old || Number(a.seen_pos||999)<Number(old.seen_pos||999))unique.set(a.hex,a);
            });
        }

        const cells=new Map();
        unique.forEach(a=>{
            try{
                const cell=h3.latLngToCell(Number(a.lat),Number(a.lon),5);
                if(!cells.has(cell))cells.set(cell,[]);
                cells.get(cell).push(Number(a.nac_p));
            }catch(e){}
        });

        let medium=0,high=0;
        cells.forEach((values,cell)=>{
            if(values.length<3)return;
            const d8=values.filter(v=>v<=8).length;
            const d7=values.filter(v=>v<=7).length;
            if(d8/values.length<0.5)return;

            const isHigh=d7/values.length>=0.5;
            const boundary=h3.cellToBoundary(cell,true);
            const latlngs=boundary.map(([lng,lat])=>[lat,lng]);
            const color=isHigh?"#dc2626":"#f59e0b";

            L.polygon(latlngs,{
                pane:"gpsPane",color,weight:1,opacity:.95,
                fillColor:color,fillOpacity:isHigh?.62:.44,interactive:false
            }).addTo(liveLayer);

            isHigh?high++:medium++;
        });

        liveLastUpdated=new Date();
        document.querySelector(".status").textContent="● LIVE GNSS DATA READY";
        document.getElementById("routeResult").innerHTML=
            "<strong>LIVE GNSS QUALITY</strong><br>"+
            "Observed aircraft: <strong>"+unique.size+"</strong><br>"+
            "Degraded cells: <strong>"+medium+"</strong><br>"+
            "High degradation cells: <strong>"+high+"</strong><br>"+
            "Updated: <strong>"+liveLastUpdated.toLocaleTimeString([], {hour:"2-digit",minute:"2-digit",second:"2-digit"})+"</strong>";

        drawBlueRouteOnly(from,to);
    }catch(err){
        console.error(err);
        document.querySelector(".status").textContent="● LIVE DATA UNAVAILABLE";
        showError("Live data unavailable: "+err.message);
    }
}

function drawBlueRouteOnly(from,to){
    routeLayer.clearLayers();
    const a=[airportLat(from),airportLon(from)];
    const b=[airportLat(to),airportLon(to)];
    L.polyline([a,b],{
        pane:"routePane",color:"#1261c9",weight:5,opacity:1,interactive:false
    }).addTo(routeLayer);
    markerLayer.clearLayers();
    addAirportMarker(from);
    addAirportMarker(to);
}

function drawGpsjam(){
    gpsjamLayer.clearLayers();

    if(typeof h3 === "undefined"){
        console.error("H3 library is not available. GPSJAM cannot be rendered.");
        showError("GPSJAM library failed to load. Refresh the page and check the browser console.");
        return;
    }

    let displayed=0;

    for(const cell of gpsjam){

        const pct=Number(cell.bad_percent || 0);

        if(pct < 20) continue;

        try{
            // H3 GeoJSON mode returns [lng, lat].
            // Leaflet needs [lat, lng].
            const boundary=h3.cellToBoundary(cell.hex,true);
            const latlngs=boundary.map(([lng,lat])=>[lat,lng]);

            const color=pct>=50 ? "#dc2626" : "#f59e0b";

            L.polygon(latlngs,{
                pane:"gpsPane",
                color:color,
                weight:0.7,
                opacity:0.95,
                fillColor:color,
                fillOpacity:pct>=50 ? 0.58 : 0.42,
                interactive:false
            }).addTo(gpsjamLayer);

            displayed++;

        }catch(err){
            console.warn("GPSJAM cell failed:",cell.hex,err);
        }
    }

    console.log("GPSJAM cells rendered:",displayed);
}

function updateCountryLabels(){
    if(!worldLabelLayer || !map)return;

    const zoom=map.getZoom();

    worldLabelLayer.eachLayer(layer=>{
        const el=layer.getElement();
        if(!el)return;

        // Keep the world view clean; show names from zoom 3 onward.
        el.style.display=zoom>=3?"block":"none";
        el.style.fontSize=zoom>=5?"10px":"9px";
    });
}

function findAirport(value){
    const s=String(value||"").trim().toUpperCase();
    return airports.find(a=>{
        const iata=String(a.iata_code||a.iata||"").trim().toUpperCase();
        const icao=String(a.ident||a.icao_code||a.icao||"").trim().toUpperCase();
        return iata===s||icao===s;
    })||null;
}

function airportLat(a){return Number(a.latitude_deg??a.latitude??a.lat)}
function airportLon(a){return Number(a.longitude_deg??a.longitude??a.lon??a.lng)}
function airportName(a){return a.name||a.airport_name||a.ident||"Airport"}
function airportCode(a){return a.iata_code||a.iata||a.ident||a.icao_code||a.icao||""}


function checkRoute(){
    clearError();
    if(currentMode==="live"){
        startLiveMode();
        return;
    }

    const from=findAirport(document.getElementById("from").value);
    const to=findAirport(document.getElementById("to").value);
    const speed=Number(document.getElementById("speed").value);

    if(!from){showError("Origin airport not found.");return}
    if(!to){showError("Destination airport not found.");return}
    if(!speed||speed<=0){showError("Please enter a valid average speed.");return}

    analyzeRoute(from,to,speed);
}

function analyzeRoute(from,to,speed){
    routeLayer.clearLayers();
    markerLayer.clearLayers();

    const fromLat=airportLat(from),fromLon=airportLon(from);
    const toLat=airportLat(to),toLon=airportLon(to);

    const route=turf.lineString([
        [fromLon,fromLat],
        [toLon,toLat]
    ]);

    const distanceKm=turf.length(route,{units:"kilometers"});
    const steps=Math.max(1,Math.ceil(distanceKm));

    let interferenceKm=0;
    let highInterferenceKm=0;
    let spoofingKm=0;

    const segments=[];

    for(let i=0;i<steps;i++){
        const startKm=distanceKm*i/steps;
        const endKm=distanceKm*(i+1)/steps;
        const midKm=(startKm+endKm)/2;

        const start=turf.along(route,startKm,{units:"kilometers"});
        const end=turf.along(route,endKm,{units:"kilometers"});
        const mid=turf.along(route,midKm,{units:"kilometers"});

        const [lon,lat]=mid.geometry.coordinates;
        const chunkKm=endKm-startKm;

        let interference=false;
        let high=false;

        try{
            const cell=h3.latLngToCell(lat,lon,4);
            const data=gpsjamByHex.get(cell);

            if(data){
                const pct=Number(data.bad_percent||0);

                if(pct>=20){
                    interference=true;
                    interferenceKm+=chunkKm;
                }

                if(pct>=50){
                    high=true;
                    highInterferenceKm+=chunkKm;
                }
            }
        }catch(err){}

        segments.push({
            start:start.geometry.coordinates,
            end:end.geometry.coordinates,
            interference,
            high
        });
    }

    /*
     * Draw the complete route in BLUE first.
     * Then draw only affected portions on top.
     * There is NO white route underneath.
     */
    L.polyline(
        [[fromLat,fromLon],[toLat,toLon]],
        {
            pane:"routePane",
            color:"#1261c9",
            weight:5,
            opacity:1,
            interactive:false
        }
    ).addTo(routeLayer);

    segments.forEach(s=>{
        let color=null;

        if(s.high)color="#dc2626";
        else if(s.interference)color="#f59e0b";

        if(!color)return;

        L.polyline(
            [[s.start[1],s.start[0]],[s.end[1],s.end[0]]],
            {
                pane:"routePane",
                color:color,
                weight:7,
                opacity:.98,
                interactive:false
            }
        ).addTo(routeLayer);
    });

    addAirportMarker(from);
    addAirportMarker(to);

    map.fitBounds(
        [[fromLat,fromLon],[toLat,toLon]],
        {padding:[55,55],maxZoom:6}
    );

    const interferenceMinutes=interferenceKm/speed*60;
    const spoofingMinutes=spoofingKm/speed*60;

    updateResult(
        from,to,distanceKm,
        interferenceMinutes,
        spoofingMinutes
    );

    generateEmailStatement(
        from,to,
        interferenceMinutes,
        spoofingMinutes
    );

    setTimeout(()=>map.invalidateSize(true),250);
}

function escapeHtml(value){
    return String(value)
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/\"/g,"&quot;")
        .replace(/'/g,"&#039;");
}

function addAirportMarker(airport){

    const code=airportCode(airport);

    const city=
        airport.municipality ||
        airport.city ||
        airport.locality ||
        "";

    const country=
        airport.iso_country ||
        airport.country_code ||
        "";

    const name=airportName(airport);

    const label =
        code +
        (city ? " • " + city : "");

    const icon=L.divIcon({
        className:"",
        html:'<div class="airport-marker"></div>',
        iconSize:[14,14],
        iconAnchor:[7,7]
    });

    const marker=L.marker(
        [airportLat(airport),airportLon(airport)],
        {
            pane:"markerPane",
            icon:icon,
            zIndexOffset:3000
        }
    ).addTo(markerLayer);

    // Airport name appears only for the airports selected in the route.
    marker.bindTooltip(
        label,
        {
            permanent:true,
            direction:"right",
            offset:[9,0],
            className:"airport-label",
            opacity:0.98
        }
    );

    marker.bindPopup(
        "<strong>"+escapeHtml(name)+"</strong><br>"+
        escapeHtml(code)+
        (city ? "<br>"+escapeHtml(city) : "")+
        (country ? "<br>"+escapeHtml(country) : "")
    );
}

function updateResult(from,to,distanceKm,interferenceMinutes,spoofingMinutes){
    const fromCity = from.municipality || from.city || from.locality || "";
    const toCity = to.municipality || to.city || to.locality || "";

    let text=
        "<strong>"+airportCode(from)+" → "+airportCode(to)+"</strong><br>"+
        (fromCity ? fromCity : airportName(from))+
        " → "+
        (toCity ? toCity : airportName(to))+
        "<br>"+
        Math.round(distanceKm).toLocaleString()+" km";

    text+="<br><br>GNSS interference: <strong>"+
        formatMinutes(interferenceMinutes)+"</strong>";



    const result=document.getElementById("routeResult");
    result.innerHTML=text;
    result.dataset.routeChecked="true";
}

function generateEmailStatement(from,to,interferenceMinutes,spoofingMinutes){
    const a=airportCode(from),b=airportCode(to);
    let reason="";

    if(interferenceMinutes>0)
        reason="potential GNSS interference activity";

    if(reason){
        currentEmail=
            "Subject: GNSS Interference Assessment – "+a+" to "+b+
            "\n\nThe "+a+" to "+b+
            " route was identified as being affected by "+reason+".";
    }else{
        currentEmail=
            "Subject: GNSS Interference Assessment – "+a+" to "+b+
            "\n\nNo GNSS interference or spoofing indicators were identified along the "+
            a+"–"+b+" route.";
    }

    document.getElementById("emailStatement").textContent=currentEmail;
}

function formatMinutes(minutes){
    if(!minutes||minutes<.5)return"0 min";
    if(minutes<60)return Math.round(minutes)+" min";

    const h=Math.floor(minutes/60);
    const m=Math.round(minutes%60);

    return m===0?h+"h":h+"h "+m+"m";
}

async function copyEmail(){
    if(!currentEmail){
        showError("Run a route analysis first.");
        return;
    }

    try{
        await navigator.clipboard.writeText(currentEmail);
        const b=document.querySelector(".copy-btn");
        const old=b.textContent;
        b.textContent="COPIED";
        setTimeout(()=>b.textContent=old,1500);
    }catch(err){
        showError("Could not copy the statement.");
    }
}

function showError(message){
    const e=document.getElementById("error");
    e.textContent=message;
    e.style.display="block";
}

function clearError(){
    const e=document.getElementById("error");
    e.textContent="";
    e.style.display="none";
}

window.addEventListener("resize",()=>{
    if(map)setTimeout(()=>map.invalidateSize(true),100);
});

loadData();
</script>
</body>
</html>